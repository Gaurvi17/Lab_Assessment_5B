#include <stdio.h>
#include <string.h>

int max(int a, int b)
{
    return (a > b) ? a : b;
}

int main()
{
    char S1[100], S2[100];
    int m, n;
    printf("Enter first string: ");
    scanf("%s\n", S1);
    printf("Enter second string: ");
    scanf("%s", S2);

    m = strlen(S1);
    n = strlen(S2);

    int dp[m + 1][n + 1];

    for (int i = 0; i <= m; i++)
    {
        for (int j = 0; j <= n; j++)
        {
            if (i == 0 || j == 0)
            {
                dp[i][j] = 0;
            }
            else if (S1[i - 1] == S2[j - 1])
            {
                dp[i][j] = dp[i - 1][j - 1] + 1;
            }
            else
            {
                dp[i][j] = max(dp[i - 1][j], dp[i][j - 1]);
            }
        }
    }

    printf("\nLength of Longest Common Subsequence = %d\n", dp[m][n]);

    return 0;
}
